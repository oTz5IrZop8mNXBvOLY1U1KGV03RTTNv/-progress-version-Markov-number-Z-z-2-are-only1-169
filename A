lemma reduces_to_pell (hz : z ≥ 14) (hx : 0 < x) (h : MarkovSqEq x z m) :
    ∃ s : ℕ, (s : ℤ)^2 - 5 * (z : ℤ)^4 = -4 := by
  obtain ⟨k, hk, hm⟩ := exists_k hx (by omega) h
  have hk2 := k_eq_2_for_large_z hz hx h hk hm
  rw [hk2] at hm
  have heq := eq_after_subst hx (by omega) h (by omega : (2 : ℕ) ≥ 2) hm
  have h1 : 4 * (x : ℤ)^2 - 12 * (x : ℤ) * (z : ℤ)^2 + 4 * (z : ℤ)^4 + 4 = 0 := by
    calc
      4 * (x : ℤ)^2 - 12 * (x : ℤ) * (z : ℤ)^2 + 4 * (z : ℤ)^4 + 4
        = 4 * (x : ℤ)^2 - 12 * (x : ℤ) * (z : ℤ)^2 + 4 + 4 * (z : ℤ)^4 := by ring
      _ = 0 := by simpa [hk2] using heq
  have hsq : (2 * (x : ℤ) - 3 * (z : ℤ)^2)^2 = 5 * (z : ℤ)^4 - 4 := by
    calc
      (2 * (x : ℤ) - 3 * (z : ℤ)^2)^2
          = 4 * (x : ℤ)^2 - 12 * (x : ℤ) * (z : ℤ)^2 + 9 * (z : ℤ)^4 := by ring
      _ = (4 * (x : ℤ)^2 - 12 * (x : ℤ) * (z : ℤ)^2 + 4 * (z : ℤ)^4 + 4)
            + 5 * (z : ℤ)^4 - 4 := by ring
      _ = 0 + 5 * (z : ℤ)^4 - 4 := by rw [h1]
      _ = 5 * (z : ℤ)^4 - 4 := by ring
  use (2 * (x : ℤ) - 3 * (z : ℤ) ^ 2).natAbs
  simp only [Int.natAbs_sq]
  linarith [hsq]


/--
【主定理】
自然数 s, z (z > 0) に対する方程式 s^2 - 5z^4 = -4 の解は z = 1 または z = 12 のみである。
-/
lemma solutions_of_s2_minus_5z4_eq_neg4 (s z : ℕ) (hz0 : 0 < z)
    (h : (s : ℤ) ^ 2 - 5 * (z : ℤ) ^ 4 = -4) : z = 1 ∨ z = 12 := by
  -- 変数 X = s, Y = z^2 を定義
  set X : ℤ := (s : ℤ)
  set Y : ℤ := (z : ℤ)^2 with hY
  -- Y^2 = z^4 の関係式を導出し、Pell 方程式 X^2 - 5Y^2 = -4 の形に代入整理
  have hY4 : Y ^ 2 = (z : ℤ) ^ 4 := by
    rw [hY]
    ring
  have hPell : X ^ 2 - 5 * Y ^ 2 = -4 := by
    linarith [h, hY4]
  -- Y が平方数（IsSquare Y）かつ Positive であることを証明
  have hsq : IsSquare Y := ⟨(z : ℤ), by rw [hY]; ring⟩
  have hY_pos : 0 < Y := by
    rw [hY]
    positivity
  -- Cohn の定理 (axiom) を適用して Y = 1 ∨ Y = 144 を導出
  have hY_cases : Y = 1 ∨ Y = 144 := cohn_pell_square_sol X Y hPell hsq hY_pos
  -- z ≥ 0 の条件を準備
  have hz_nonneg : 0 ≤ (z : ℤ) := by positivity
  -- Y の 2 つのケース（1 または 144）に分けて z の値を決定
  rcases hY_cases with hY1 | hY144
  · -- ケース 1: Y = 1 ⟹ z^2 = 1 ⟹ z = 1
    left
    have hz_sq : (z : ℤ) ^ 2 = 1 := by rw [← hY, hY1]
    have hz_int : (z : ℤ) = 1 := by nlinarith [hz_sq, hz_nonneg]
    exact_mod_cast hz_int
  · -- ケース 2: Y = 144 ⟹ z^2 = 144 ⟹ z = 12
    right
    have hz_sq : (z : ℤ) ^ 2 = 144 := by rw [← hY, hY144]
    have hz_int : (z : ℤ) = 12 := by nlinarith [hz_sq, hz_nonneg]
    exact_mod_cast hz_int

theorem no_solution_for_z_ge_14 (hz : z ≥ 14) (hx : 0 < x) :
    ¬ ∃ m, MarkovSqEq x z m := by
  intro ⟨m, h⟩
  obtain ⟨s, hs⟩ := reduces_to_pell hz hx h
  -- 第3引数に `(by omega)` を追加して 0 < z を与える
  have hsol := solutions_of_s2_minus_5z4_eq_neg4 s z (by omega) hs
  omega

